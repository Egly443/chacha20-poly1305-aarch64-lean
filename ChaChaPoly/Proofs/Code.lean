module

public import ProofLib
public import ProofLib.Placed
public import ProofLib.GenPlacedFetches
public meta import ProofLib.Process
public meta import ProofLib.ProgramReflection
public import ChaChaPoly.Generated.ChachapolyPlacedObj

/-!
# Code reflection for the blocks of `chachapolyLib` (generated by `scripts/gen-proof-boilerplate`)

Untrusted proof infrastructure: single-block views of the multi-block placed library, `WordTree`
reflections of their code, and per-instruction fetch lemmas valid for every placement.
-/

@[expose] public section

namespace ChaChaPoly.Proofs

open Arm64 Arm64.Obj ProofLib ProofLib.ProgramReflection ProofLib.GenPlacedFetches
open ChaChaPoly

set_option maxRecDepth 200000

/-- An arbitrary placement of `chachapolyLib` by a static linker. -/
class CpPlacement where
  mpl : MultiPlacement
  placeable : chachapolyLib.Placeable mpl

abbrev cpMpl [CpPlacement] : MultiPlacement := CpPlacement.mpl

/-! ## Block 0 -/

def cpLib0 : PlacedLib := chachapolyLib.blockLib 0
def cpPl0 [CpPlacement] : Placement := chachapolyLib.blockPlacement cpMpl 0
theorem cpPlaceable0 [CpPlacement] : cpLib0.Placeable cpPl0 :=
  chachapolyLib.placeable_blockLib (by decide) CpPlacement.placeable
def cpPC0 [CpPlacement] : Program := cpLib0.program cpPl0
/-- Block 0 as a program at its placed base, without hooks. -/
abbrev cpProg0r [CpPlacement] : Program := cpPC0.rebase cpPl0.base (fun _ => none)

def cpProg0 : Program := { code := cpLib0.text.code, symbols := cpLib0.text.symbols }
def cpTree0 : WordTree := word_tree_of% cpProg0
theorem cp0_code_eq : cpLib0.text.code = cpTree0.toBytes := by rfl_kernel
theorem cp0_tree_size : cpTree0.checkSize? = some 5 := by rfl_kernel
def cpSymChars0 : List (List Char × Nat) := sym_chars_of% cpProg0
theorem cp0_symbols_eq : cpLib0.text.symbols = toStringSymbols cpSymChars0 := by rfl_kernel
theorem cp0_symbols_fresh : allFreshCharSymbols cpSymChars0 = true := by rfl_kernel

gen_placed_fetches cpPC0 cpLib0 cpTree0 cp0_code_eq cp0_tree_size
  via_placement cpPl0 cpPlaceable0 [0x0 → 0x10]
gen_placed_fnOffs cpPC0 cpLib0 cpSymChars0 cp0_symbols_eq cp0_symbols_fresh

