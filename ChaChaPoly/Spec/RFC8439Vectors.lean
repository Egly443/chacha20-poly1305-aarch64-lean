module

public import ChaChaPoly.Spec.RFC8439

/-!
# RFC 8439 test vectors for the reference model

Each test vector below is evaluated by the Lean kernel (`decide +kernel`), so the model in
`Spec/RFC8439.lean` provably reproduces the RFC's published values. No `native_decide`.
-/

@[expose] public section

namespace ChaChaPoly.Spec.Vectors

open ChaChaPoly.Spec

/-- Bytes of an ASCII string. -/
def ascii (s : String) : Bytes := s.toList.map fun c => BitVec.ofNat 8 c.toNat

/-- Bytes `lo, lo+1, …` (`n` of them). -/
def range (lo n : Nat) : Bytes := (List.range n).map fun i => BitVec.ofNat 8 (lo + i)

/-- §2.1.1: quarter round. -/
example : quarterRound 0x11111111 0x01020304 0x9b8d6f43 0x01234567 =
    (0xea2a92f4, 0xcb1cf8ce, 0x4581472e, 0x5881c4bb) := by decide +kernel

/-- §2.3.2: block function, key `00..1f`, counter `1`, nonce `00 00 00 09 00 00 00 4a 00 00 00 00`. -/
example : chacha20Block (range 0 32) 1 [0,0,0,9, 0,0,0,0x4a, 0,0,0,0] =
    [0x10,0xf1,0xe7,0xe4,0xd1,0x3b,0x59,0x15,0x50,0x0f,0xdd,0x1f,0xa3,0x20,0x71,0xc4,
     0xc7,0xd1,0xf4,0xc7,0x33,0xc0,0x68,0x03,0x04,0x22,0xaa,0x9a,0xc3,0xd4,0x6c,0x4e,
     0xd2,0x82,0x64,0x46,0x07,0x9f,0xaa,0x09,0x14,0xc2,0xd7,0x05,0xd9,0x8b,0x02,0xa2,
     0xb5,0x12,0x9c,0xd1,0xde,0x16,0x4e,0xb9,0xcb,0xd0,0x83,0xe8,0xa2,0x50,0x3c,0x4e] := by
  decide +kernel

def sunscreen : Bytes := ascii
  "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."

/-- §2.4.2: ChaCha20 encryption, counter `1`, nonce `00 00 00 00 00 00 00 4a 00 00 00 00`. -/
example : chacha20Encrypt (range 0 32) 1 [0,0,0,0, 0,0,0,0x4a, 0,0,0,0] sunscreen =
    [0x6e,0x2e,0x35,0x9a,0x25,0x68,0xf9,0x80,0x41,0xba,0x07,0x28,0xdd,0x0d,0x69,0x81,
     0xe9,0x7e,0x7a,0xec,0x1d,0x43,0x60,0xc2,0x0a,0x27,0xaf,0xcc,0xfd,0x9f,0xae,0x0b,
     0xf9,0x1b,0x65,0xc5,0x52,0x47,0x33,0xab,0x8f,0x59,0x3d,0xab,0xcd,0x62,0xb3,0x57,
     0x16,0x39,0xd6,0x24,0xe6,0x51,0x52,0xab,0x8f,0x53,0x0c,0x35,0x9f,0x08,0x61,0xd8,
     0x07,0xca,0x0d,0xbf,0x50,0x0d,0x6a,0x61,0x56,0xa3,0x8e,0x08,0x8a,0x22,0xb6,0x5e,
     0x52,0xbc,0x51,0x4d,0x16,0xcc,0xf8,0x06,0x81,0x8c,0xe9,0x1a,0xb7,0x79,0x37,0x36,
     0x5a,0xf9,0x0b,0xbf,0x74,0xa3,0x5b,0xe6,0xb4,0x0b,0x8e,0xed,0xf2,0x78,0x5e,0x42,
     0x87,0x4d] := by decide +kernel

/-- §2.5.2: Poly1305. -/
example : poly1305Mac
    [0x85,0xd6,0xbe,0x78,0x57,0x55,0x6d,0x33,0x7f,0x44,0x52,0xfe,0x42,0xd5,0x06,0xa8,
     0x01,0x03,0x80,0x8a,0xfb,0x0d,0xb2,0xfd,0x4a,0xbf,0xf6,0xaf,0x41,0x49,0xf5,0x1b]
    (ascii "Cryptographic Forum Research Group") =
    [0xa8,0x06,0x1d,0xc1,0x30,0x51,0x36,0xc6,0xc2,0x2b,0x8b,0xaf,0x0c,0x01,0x27,0xa9] := by
  decide +kernel

/-- §2.6.2: Poly1305 key generation. -/
example : poly1305KeyGen (range 0x80 32) [0,0,0,0, 0,1,2,3, 4,5,6,7] =
    [0x8a,0xd5,0xa0,0x8b,0x90,0x5f,0x81,0xcc,0x81,0x50,0x40,0x27,0x4a,0xb2,0x94,0x71,
     0xa8,0x33,0xb6,0x37,0xe3,0xfd,0x0d,0xa5,0x08,0xdb,0xb8,0xe2,0xfd,0xd1,0xa6,0x46] := by
  decide +kernel

def aeadKey : Bytes := range 0x80 32
def aeadNonce : Bytes := [0x07,0,0,0, 0x40,0x41,0x42,0x43,0x44,0x45,0x46,0x47]
def aeadAad : Bytes := [0x50,0x51,0x52,0x53,0xc0,0xc1,0xc2,0xc3,0xc4,0xc5,0xc6,0xc7]
def aeadCt : Bytes :=
    [0xd3,0x1a,0x8d,0x34,0x64,0x8e,0x60,0xdb,0x7b,0x86,0xaf,0xbc,0x53,0xef,0x7e,0xc2,
     0xa4,0xad,0xed,0x51,0x29,0x6e,0x08,0xfe,0xa9,0xe2,0xb5,0xa7,0x36,0xee,0x62,0xd6,
     0x3d,0xbe,0xa4,0x5e,0x8c,0xa9,0x67,0x12,0x82,0xfa,0xfb,0x69,0xda,0x92,0x72,0x8b,
     0x1a,0x71,0xde,0x0a,0x9e,0x06,0x0b,0x29,0x05,0xd6,0xa5,0xb6,0x7e,0xcd,0x3b,0x36,
     0x92,0xdd,0xbd,0x7f,0x2d,0x77,0x8b,0x8c,0x98,0x03,0xae,0xe3,0x28,0x09,0x1b,0x58,
     0xfa,0xb3,0x24,0xe4,0xfa,0xd6,0x75,0x94,0x55,0x85,0x80,0x8b,0x48,0x31,0xd7,0xbc,
     0x3f,0xf4,0xde,0xf0,0x8e,0x4b,0x7a,0x9d,0xe5,0x76,0xd2,0x65,0x86,0xce,0xc6,0x4b,
     0x61,0x16]
def aeadTag : Bytes :=
    [0x1a,0xe1,0x0b,0x59,0x4f,0x09,0xe2,0x6a,0x7e,0x90,0x2e,0xcb,0xd0,0x60,0x06,0x91]

/-- §2.8.2: AEAD encryption. -/
example : aeadEncrypt aeadKey aeadNonce aeadAad sunscreen = (aeadCt, aeadTag) := by decide +kernel

/-- §2.8.2, in reverse: AEAD decryption accepts and returns the plaintext. -/
example : aeadDecrypt aeadKey aeadNonce aeadAad aeadCt aeadTag = some sunscreen := by decide +kernel

/-- A modified ciphertext is rejected. -/
example : aeadDecrypt aeadKey aeadNonce aeadAad (0xd2 :: aeadCt.tail) aeadTag = none := by
  decide +kernel

end ChaChaPoly.Spec.Vectors
