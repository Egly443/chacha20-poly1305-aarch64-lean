#!/usr/bin/env python3
"""Regenerate `ChaChaPoly/Proofs/Code.lean`: per-block code reflection and fetch lemmas.

For every code block `i` of `chachapolyLib` listed in BLOCKS this emits the single-block view
`cpLib<i>`, its placement under an arbitrary `CpPlacement`, a `WordTree` of its code, and the
kernel-checked instruction fetch lemmas (`gen_placed_fetches`). Everything it emits is untrusted
proof infrastructure: the kernel checks each fact against `chachapolyLib`.
"""
import pathlib

# (block index, number of instructions)
BLOCKS = [(0, 5), (1, 82), (2, 5), (3, 167), (4, 295), (5, 410), (6, 307), (7, 74), (8, 59), (9, 2), (10, 24)]

HEADER = '''module

public import ProofLib
public import ProofLib.Placed
public import ProofLib.GenPlacedFetches
public meta import ProofLib.Process
public meta import ProofLib.ProgramReflection
public import ChaChaPoly.Generated.ChachapolyPlacedObj

/-!
# Code reflection for the blocks of `chachapolyLib` (generated by `scripts/gen-proof-boilerplate`)

Untrusted proof infrastructure: single-block views of the multi-block placed library, `WordTree`
reflections of their code, and per-instruction fetch lemmas valid for every placement.
-/

@[expose] public section

namespace ChaChaPoly.Proofs

open Arm64 Arm64.Obj ProofLib ProofLib.ProgramReflection ProofLib.GenPlacedFetches
open ChaChaPoly

set_option maxRecDepth 200000

/-- An arbitrary placement of `chachapolyLib` by a static linker. -/
class CpPlacement where
  mpl : MultiPlacement
  placeable : chachapolyLib.Placeable mpl

abbrev cpMpl [CpPlacement] : MultiPlacement := CpPlacement.mpl
'''

def block(i, n):
    last = hex(4 * (n - 1))
    return f'''
/-! ## Block {i} -/

def cpLib{i} : PlacedLib := chachapolyLib.blockLib {i}
def cpPl{i} [CpPlacement] : Placement := chachapolyLib.blockPlacement cpMpl {i}
theorem cpPlaceable{i} [CpPlacement] : cpLib{i}.Placeable cpPl{i} :=
  chachapolyLib.placeable_blockLib (by decide) CpPlacement.placeable
def cpPC{i} [CpPlacement] : Program := cpLib{i}.program cpPl{i}
/-- Block {i} as a program at its placed base, without hooks. -/
abbrev cpProg{i}r [CpPlacement] : Program := cpPC{i}.rebase cpPl{i}.base (fun _ => none)

def cpProg{i} : Program := {{ code := cpLib{i}.text.code, symbols := cpLib{i}.text.symbols }}
def cpTree{i} : WordTree := word_tree_of% cpProg{i}
theorem cp{i}_code_eq : cpLib{i}.text.code = cpTree{i}.toBytes := by rfl_kernel
theorem cp{i}_tree_size : cpTree{i}.checkSize? = some {n} := by rfl_kernel
def cpSymChars{i} : List (List Char × Nat) := sym_chars_of% cpProg{i}
theorem cp{i}_symbols_eq : cpLib{i}.text.symbols = toStringSymbols cpSymChars{i} := by rfl_kernel
theorem cp{i}_symbols_fresh : allFreshCharSymbols cpSymChars{i} = true := by rfl_kernel

gen_placed_fetches cpPC{i} cpLib{i} cpTree{i} cp{i}_code_eq cp{i}_tree_size
  via_placement cpPl{i} cpPlaceable{i} [0x0 → {last}]
gen_placed_fnOffs cpPC{i} cpLib{i} cpSymChars{i} cp{i}_symbols_eq cp{i}_symbols_fresh
'''

out = HEADER + "".join(block(i, n) for i, n in BLOCKS) + "\nend ChaChaPoly.Proofs\n"
path = pathlib.Path(__file__).resolve().parent.parent / "ChaChaPoly" / "Proofs" / "Code.lean"
path.write_text(out)
print(f"wrote {path}")
