#!/usr/bin/env python3
"""Derive the comparator challenge from `ChaChaPoly/Theorems/Headline.lean`.

The challenge has the same theorem names and statements, byte for byte, with every proof replaced
by `sorry` and every proof import removed, so it depends only on specification modules.

  scripts/gen-challenge          write comparator/ComparatorChallenge/Headline.lean and
                                 comparator/chachapoly.json
  scripts/gen-challenge --check  fail if either file is out of date
"""
import json, pathlib, re, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SRC = ROOT / "ChaChaPoly" / "Theorems" / "Headline.lean"
DST = ROOT / "comparator" / "ComparatorChallenge" / "Headline.lean"
CFG = ROOT / "comparator" / "chachapoly.json"

src = SRC.read_text()
# Private imports are the proof modules; the challenge keeps only the public (spec) imports.
lines = [l for l in src.splitlines() if not re.match(r"^import ", l)]
text = "\n".join(lines) + "\n"
text = text.replace(
    "# Headline theorems",
    "# Comparator challenge (generated by `scripts/gen-challenge` — do not edit)\n\n"
    "**Trusted: the statements.** Same names and statements as "
    "`ChaChaPoly/Theorems/Headline.lean`,\nwith `sorry` proofs and no proof imports.\n\n"
    "Original header follows.\n\n# Headline theorems", 1)

names, out, pos = [], [], 0
ns = re.search(r"^namespace (\S+)", text, re.M).group(1)
for m in re.finditer(r"^theorem (\S+)", text, re.M):
    start = m.start()
    end_sig = text.index(":=", start)
    nxt = text.find("\n\n", end_sig)
    out.append(text[pos:end_sig] + ":=\n  sorry")
    pos = nxt
    names.append(f"{ns}.{m.group(1)}")
out.append(text[pos:])
challenge = "".join(out)
config = json.dumps({
    "challenge_module": "ComparatorChallenge.Headline",
    "solution_module": "ComparatorSolution",
    "theorem_names": names,
    "permitted_axioms": ["propext", "Quot.sound", "Classical.choice"],
    "enable_nanoda": False,
}, indent=2) + "\n"

if "--check" in sys.argv:
    ok = DST.read_text() == challenge and CFG.read_text() == config
    print("challenge up to date" if ok else "challenge OUT OF DATE: run scripts/gen-challenge")
    sys.exit(0 if ok else 1)
DST.write_text(challenge)
CFG.write_text(config)
print(f"wrote {DST.relative_to(ROOT)} and {CFG.relative_to(ROOT)} ({len(names)} theorems)")
